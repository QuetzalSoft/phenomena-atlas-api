PORT=8000
# The web client's origin, allowed by CORS. Comma-separated for several.
WEB_ORIGIN=http://localhost:3000
# Validate responses against the contract. On in tests, off in production.
VALIDATE_RESPONSES=false
# PostgreSQL with PostGIS. Matches the database in compose.yaml.
DATABASE_URL=postgres://phenomena:phenomena@localhost:5432/phenomena_atlas
# Access tokens come from Keycloak. Match the realm in compose.yaml.
AUTH_ISSUER=http://localhost:8080/realms/phenomena-atlas
AUTH_AUDIENCE=phenomena-atlas-api
AUTH_JWKS_URL=http://localhost:8080/realms/phenomena-atlas/protocol/openid-connect/certs
# Seconds the index tick leaves free before the Lambda function's timeout, starting no new
# computation in them. 60 when unset. Only the Lambda handler reads it.
INDEX_TICK_MARGIN_SECONDS=60
# The API edits account details in Keycloak with a service account. The client is in the
# development realm; its secret here is a development-only value. Deployments set their own.
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/phenomena-atlas/protocol/openid-connect/token
KEYCLOAK_ADMIN_URL=http://localhost:8080/admin/realms/phenomena-atlas
KEYCLOAK_ADMIN_CLIENT_ID=phenomena-atlas-account-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-account-admin-secret

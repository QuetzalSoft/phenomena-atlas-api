PORT=8000
# The web client's origin, allowed by CORS. Comma-separated for several.
WEB_ORIGIN=http://localhost:3000
# Validate responses against the contract. On in tests, off in production.
VALIDATE_RESPONSES=false
# PostgreSQL with PostGIS. Matches the database in compose.yaml.
DATABASE_URL=postgres://phenomena:phenomena@localhost:5432/phenomena_atlas
# Access tokens come from Keycloak. Match the realm in compose.yaml.
AUTH_ISSUER=http://localhost:8080/realms/phenomena-atlas
AUTH_AUDIENCE=phenomena-atlas-api
AUTH_JWKS_URL=http://localhost:8080/realms/phenomena-atlas/protocol/openid-connect/certs

{
  "realm": "phenomena-atlas",
  "displayName": "Phenomena Atlas",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "phenomena-atlas-web",
      "name": "Phenomena Atlas web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "phenomena-atlas-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@phenomena-atlas.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dev", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "admin",
      "email": "admin@phenomena-atlas.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }]
    }
  ]
}
